// FedFleet tailnet policy (Tailscale admin console > Access controls > JSON editor).
// This file is the source of truth: change it here, review it, then paste it into the editor.
// Saving runs the tests below; a change that breaks them is refused.
// Live since 24 Nov 2026; Hashim's SSH rule added 27 Nov 2026; cold-standby region added 27 Nov 2026. Rollback: add {"src": ["*"], "dst": ["*"], "ip": ["*"]} as the
// first grant (allow-all) and save.
{
	"tagOwners": {
		"tag:aggregator":        ["autogroup:admin"],
		"tag:site":              ["autogroup:admin"],
		// Where an aggregator runs (what its sites' updates are sent to).
		"tag:region-ap-mumbai":  ["autogroup:admin"],
		// The cold standby aggregator (task 2.10a), created on demand in Azure India South Central.
		// Same residency zone (APAC), so an APAC site may fail over to it; an EU-only site may not.
		"tag:region-ap-indiasouthcentral": ["autogroup:admin"],
		// Which aggregator regions a site allows its updates to go to.
		"tag:residency-apac":    ["autogroup:admin"],
		"tag:residency-eu":      ["autogroup:admin"],
	},

	"grants": [
		// FedFleet admins (the tailnet owner): every device, every port.
		{"src": ["autogroup:admin"], "dst": ["*"], "ip": ["*"]},

		// Data residency: a site may join only an aggregator in a region it allows.
		{"src": ["tag:residency-apac"], "dst": ["tag:region-ap-mumbai", "tag:region-ap-indiasouthcentral"], "ip": ["tcp:9092"]},

		// Teammates: SSH and ping to the aggregator only.
		{"src": ["autogroup:member"], "dst": ["tag:aggregator"], "ip": ["tcp:22", "icmp:*"]},

		// Azure site 2 is a peer relay (Mac to aggregator path).
		{
			"src": ["autogroup:member", "tag:aggregator", "tag:site"],
			"dst": ["100.127.25.47"],
			"app": {"tailscale.com/cap/relay": []},
		},
	],

	// The aggregator and the Azure site run Tailscale SSH, so these rules decide who may log in.
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "check",
			"src":    ["autogroup:admin"],
			"dst":    ["tag:aggregator", "tag:site"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// Hashim (Kubernetes work, Phase 2): his own local user on the aggregator only, never
		// ubuntu or root. sudo, if needed for the k3s install, is granted on the machine for the
		// agreed slot and removed afterwards; this rule does not give it.
		{
			"action": "check",
			"src":    ["Hashim-Mughal@github"],
			"dst":    ["tag:aggregator"],
			"users":  ["hashim"],
		},
	],

	"tests": [
		// Residency: an APAC site may join the Mumbai aggregator; an EU-only site may not.
		{"src": "tag:residency-apac", "accept": ["tag:region-ap-mumbai:9092"], "deny": ["tag:region-ap-mumbai:22", "tag:region-ap-mumbai:3000"]},
		{"src": "tag:residency-eu", "deny": ["tag:region-ap-mumbai:9092", "tag:region-ap-mumbai:22"]},
		// The same holds for the standby: APAC sites may fail over to it, EU-only sites may not.
		{"src": "tag:residency-apac", "accept": ["tag:region-ap-indiasouthcentral:9092"], "deny": ["tag:region-ap-indiasouthcentral:22", "tag:region-ap-indiasouthcentral:8000"]},
		{"src": "tag:residency-eu", "deny": ["tag:region-ap-indiasouthcentral:9092"]},
		// A site with no residency tag may join nothing.
		{"src": "tag:site", "deny": ["tag:aggregator:9092", "tag:aggregator:22", "tag:aggregator:8000"]},
		// The aggregator cannot open connections to the Mac.
		{"src": "tag:aggregator", "deny": ["100.115.211.106:22"]},
		// The owner keeps everything FedFleet uses.
		// Hashim reaches the aggregator's SSH and nothing else of FedFleet.
		{"src": "Hashim-Mughal@github", "accept": ["tag:aggregator:22"], "deny": ["tag:aggregator:9092", "tag:aggregator:8000", "tag:aggregator:3000", "tag:aggregator:9090", "100.127.25.47:22", "100.115.211.106:22"]},
		{"src": "RA-1020@github", "accept": ["tag:aggregator:22", "tag:aggregator:9092", "tag:aggregator:8000", "tag:aggregator:3000", "tag:aggregator:9090", "100.127.25.47:22"]},
	],

	"sshTests": [
		{"src": "RA-1020@github", "dst": ["tag:aggregator"], "check": ["ubuntu"]},
		// Hashim logs in only as hashim, and never to the Azure site.
		{"src": "Hashim-Mughal@github", "dst": ["tag:aggregator"], "check": ["hashim"], "deny": ["ubuntu", "root"]},
		{"src": "Hashim-Mughal@github", "dst": ["tag:site"], "deny": ["ubuntu", "hashim", "root"]},
	],
}
