# /etc/fedfleet/elastic.env on the aggregator (not secret; the secret is azure-sp.json)
AZ_SUBSCRIPTION=<subscription id>
AZ_RESOURCE_GROUP=fedfleet-rg
AZ_VM=fedfleet-site2
# Deallocate after this long without a run or a queued run (seconds)
ELASTIC_IDLE_S=600
# Give up on a queued run after this long (seconds)
ELASTIC_QUEUE_TIMEOUT_S=900
# Do not start the VM once it has run this many minutes in the current UTC day
ELASTIC_BUDGET_MIN_PER_DAY=180
# B2s list price per hour (deploy/rates.toml), for the cost shown in /status
ELASTIC_VM_RATE_PER_HOUR=0.0448
