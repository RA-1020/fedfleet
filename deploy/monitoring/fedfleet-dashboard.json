{
 "uid": "fedfleet-rounds",
 "title": "FedFleet rounds",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "fedfleet-prom"
    },
    "query": {
     "query": "query_result(sort_desc(fedfleet_round_timestamp_seconds))",
     "refId": "run"
    },
    "refresh": 2,
    "multi": false,
    "includeAll": false,
    "current": {},
    "sort": 0,
    "regex": "/run=\"([^\"]+)\"/",
    "description": "One run at a time, most recently updated first"
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Round",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "fedfleet-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "fedfleet-prom"
     },
     "expr": "fedfleet_round{run=~\"$run\"}"
    }
   ],
   "id": 1
  },
  {
